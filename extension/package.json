{
  "name": "sharing-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sharing browser extension — send text, links and files between your own devices over the local network.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt dev -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@wxt-dev/module-react": "1.2.2",
    "typescript": "^5.9.0",
    "wxt": "0.21.4"
  }
}
